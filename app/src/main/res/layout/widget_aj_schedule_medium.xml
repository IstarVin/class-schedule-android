<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/medium_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:clickable="true"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/medium_primary_panel"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.35"
            android:background="@drawable/widget_panel_background"
            android:orientation="vertical"
            android:padding="13dp">

            <TextView
                android:id="@+id/medium_primary_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="NOW"
                android:textAllCaps="true"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/medium_primary_code"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/medium_primary_subject"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="2"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/medium_primary_time"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:ellipsize="end"
                android:singleLine="true"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/medium_primary_room"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:singleLine="true"
                android:textSize="11sp" />

            <Chronometer
                android:id="@+id/medium_countdown"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:ellipsize="end"
                android:singleLine="true"
                android:textSize="12sp"
                android:textStyle="bold" />

            <ProgressBar
                android:id="@+id/medium_progress"
                style="@android:style/Widget.ProgressBar.Horizontal"
                android:layout_width="match_parent"
                android:layout_height="4dp"
                android:layout_marginTop="7dp"
                android:indeterminate="false"
                android:progressDrawable="@drawable/widget_progress" />
        </LinearLayout>

        <View
            android:id="@+id/medium_divider"
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:layout_marginHorizontal="8dp"
            android:background="@color/widget_divider" />

        <LinearLayout
            android:id="@+id/medium_next_panel"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/widget_panel_background"
            android:orientation="vertical"
            android:padding="13dp">

            <TextView
                android:id="@+id/medium_next_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="NEXT"
                android:textAllCaps="true"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/medium_next_code"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/medium_next_subject"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="3"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/medium_next_time"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:ellipsize="end"
                android:singleLine="true"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/medium_next_room"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:singleLine="true"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/medium_refresh"
        android:layout_width="32dp"
        android:layout_height="26dp"
        android:layout_gravity="end"
        android:contentDescription="Refresh schedule"
        android:gravity="center"
        android:text="↻"
        android:textSize="17sp" />
</LinearLayout>
