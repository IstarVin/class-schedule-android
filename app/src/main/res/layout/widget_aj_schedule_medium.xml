<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/medium_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:clickable="true"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/medium_primary_panel"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.35"
            android:background="@drawable/widget_panel_background"
            android:orientation="vertical"
            android:padding="13dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/medium_primary_label"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:includeFontPadding="false"
                    android:text="NOW"
                    android:textAllCaps="true"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/medium_refresh"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:background="@drawable/widget_icon_button_background"
                    android:contentDescription="Refresh schedule"
                    android:gravity="center"
                    android:text="↻"
                    android:textSize="16sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/medium_primary_code"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:includeFontPadding="false"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/medium_primary_subject"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:lineSpacingExtra="1dp"
                android:maxLines="2"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/medium_primary_time"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:singleLine="true"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/medium_primary_room"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:singleLine="true"
                android:textSize="11sp" />

            <Chronometer
                android:id="@+id/medium_countdown"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:singleLine="true"
                android:textSize="12sp"
                android:textStyle="bold" />

            <ProgressBar
                android:id="@+id/medium_progress"
                style="@android:style/Widget.ProgressBar.Horizontal"
                android:layout_width="match_parent"
                android:layout_height="4dp"
                android:layout_marginTop="7dp"
                android:indeterminate="false"
                android:progressDrawable="@drawable/widget_progress" />
        </LinearLayout>

        <!-- RemoteViews only permits its allowlisted widget classes. TextView is used as an
             empty divider because a plain View causes the launcher to reject the whole widget. -->
        <TextView
            android:id="@+id/medium_divider"
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:layout_marginHorizontal="8dp"
            android:background="@color/widget_divider"
            android:text="" />

        <LinearLayout
            android:id="@+id/medium_next_panel"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/widget_panel_background"
            android:orientation="vertical"
            android:padding="13dp">

            <TextView
                android:id="@+id/medium_next_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="NEXT"
                android:textAllCaps="true"
                android:includeFontPadding="false"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/medium_next_code"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:includeFontPadding="false"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/medium_next_subject"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:lineSpacingExtra="1dp"
                android:maxLines="3"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/medium_next_time"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:singleLine="true"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/medium_next_room"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:singleLine="true"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
