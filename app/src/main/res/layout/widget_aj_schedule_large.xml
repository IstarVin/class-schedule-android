<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/large_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:clickable="true"
    android:orientation="vertical"
    android:padding="16dp">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
        <TextView android:id="@+id/large_date" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:ellipsize="end" android:singleLine="true" android:textSize="15sp" android:textStyle="bold" />
        <TextView android:id="@+id/large_refresh" android:layout_width="32dp" android:layout_height="32dp" android:contentDescription="Refresh schedule" android:gravity="center" android:text="↻" android:textSize="18sp" />
    </LinearLayout>

    <TextView android:id="@+id/large_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="8dp" android:ellipsize="end" android:singleLine="true" android:textSize="12sp" />
    <TextView android:id="@+id/large_empty" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:gravity="center" android:textSize="14sp" />

    <LinearLayout android:id="@+id/large_row_1" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:background="@drawable/widget_row_background" android:gravity="center_vertical" android:orientation="horizontal" android:padding="8dp">
        <TextView android:id="@+id/large_time_1" android:layout_width="76dp" android:layout_height="wrap_content" android:textSize="11sp" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical"><TextView android:id="@+id/large_subject_1" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:singleLine="true" android:textSize="13sp" android:textStyle="bold" /><TextView android:id="@+id/large_room_1" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:singleLine="true" android:textSize="10sp" /></LinearLayout>
        <TextView android:id="@+id/large_now_1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:text="NOW" android:textSize="10sp" android:textStyle="bold" />
    </LinearLayout>
    <LinearLayout android:id="@+id/large_row_2" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:background="@drawable/widget_row_background" android:gravity="center_vertical" android:orientation="horizontal" android:padding="8dp">
        <TextView android:id="@+id/large_time_2" android:layout_width="76dp" android:layout_height="wrap_content" android:textSize="11sp" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical"><TextView android:id="@+id/large_subject_2" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:singleLine="true" android:textSize="13sp" android:textStyle="bold" /><TextView android:id="@+id/large_room_2" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:singleLine="true" android:textSize="10sp" /></LinearLayout>
        <TextView android:id="@+id/large_now_2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:text="NOW" android:textSize="10sp" android:textStyle="bold" />
    </LinearLayout>
    <LinearLayout android:id="@+id/large_row_3" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:background="@drawable/widget_row_background" android:gravity="center_vertical" android:orientation="horizontal" android:padding="8dp">
        <TextView android:id="@+id/large_time_3" android:layout_width="76dp" android:layout_height="wrap_content" android:textSize="11sp" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical"><TextView android:id="@+id/large_subject_3" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:singleLine="true" android:textSize="13sp" android:textStyle="bold" /><TextView android:id="@+id/large_room_3" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:singleLine="true" android:textSize="10sp" /></LinearLayout>
        <TextView android:id="@+id/large_now_3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:text="NOW" android:textSize="10sp" android:textStyle="bold" />
    </LinearLayout>
    <LinearLayout android:id="@+id/large_row_4" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:background="@drawable/widget_row_background" android:gravity="center_vertical" android:orientation="horizontal" android:padding="8dp">
        <TextView android:id="@+id/large_time_4" android:layout_width="76dp" android:layout_height="wrap_content" android:textSize="11sp" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical"><TextView android:id="@+id/large_subject_4" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:singleLine="true" android:textSize="13sp" android:textStyle="bold" /><TextView android:id="@+id/large_room_4" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:singleLine="true" android:textSize="10sp" /></LinearLayout>
        <TextView android:id="@+id/large_now_4" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:text="NOW" android:textSize="10sp" android:textStyle="bold" />
    </LinearLayout>
    <LinearLayout android:id="@+id/large_row_5" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:background="@drawable/widget_row_background" android:gravity="center_vertical" android:orientation="horizontal" android:padding="8dp">
        <TextView android:id="@+id/large_time_5" android:layout_width="76dp" android:layout_height="wrap_content" android:textSize="11sp" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical"><TextView android:id="@+id/large_subject_5" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:singleLine="true" android:textSize="13sp" android:textStyle="bold" /><TextView android:id="@+id/large_room_5" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:singleLine="true" android:textSize="10sp" /></LinearLayout>
        <TextView android:id="@+id/large_now_5" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:text="NOW" android:textSize="10sp" android:textStyle="bold" />
    </LinearLayout>
    <TextView android:id="@+id/large_more" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:gravity="center" android:textSize="11sp" />
</LinearLayout>
